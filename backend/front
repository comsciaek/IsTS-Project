import React, { useEffect, useState } from 'react';
import io from 'socket.io-client';

const socket = io('http://localhost:5000', {
  auth: {
    token: 'your_jwt_token_here', // Replace with your actual JWT token
  },
});

const ReportStatusUpdater = () => {
  const [issueId, setIssueId] = useState('');
  const [status, setStatus] = useState('');

  useEffect(() => {
    socket.on('connect', () => {
      console.log('Connected to Socket.IO server');
    });

    socket.on('reportStatusUpdate', (data) => {
      console.log('Report status updated:', data);
    });

    socket.on('error', (error) => {
      console.error('Socket.IO error:', error);
    });

    return () => {
      socket.off('connect');
      socket.off('reportStatusUpdate');
      socket.off('error');
    };
  }, []);

  const handleUpdateStatus = () => {
    socket.emit('reportStatusUpdate', { issueId, status }, (response) => {
      if (response.error) {
        console.error('Error updating report status:', response.error);
      } else {
        console.log('Report status updated successfully:', response.message);
      }
    });
  };

  return (
    <div>
      <h2>Update Report Status</h2>
      <input
        type="text"
        placeholder="Issue ID"
        value={issueId}
        onChange={(e) => setIssueId(e.target.value)}
      />
      <input
        type="text"
        placeholder="Status"
        value={status}
        onChange={(e) => setStatus(e.target.value)}
      />
      <button onClick={handleUpdateStatus}>Update Status</button>
    </div>
  );
};

export default ReportStatusUpdater;